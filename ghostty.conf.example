# Star Wars — Ghostty. Hand-written so the background can carry alpha; see
# foot.ini. Hyprland does the blurring.
background = #0d0e15
foreground = #dcd6e6
background-opacity = 0.72
# Ask the compositor for blur explicitly; see the note in foot.ini.
background-blur = true
cursor-color = #ffffff
selection-background = #26354f
selection-foreground = #ffffff

palette = 0=#0d0e15
palette = 1=#e5484d
palette = 2=#3ddc97
palette = 3=#f0c05a
palette = 4=#4d9bff
palette = 5=#9b5cff
palette = 6=#4fd1e8
palette = 7=#dcd6e6
palette = 8=#5e5a74
palette = 9=#ff6b72
palette = 10=#74efb8
palette = 11=#ffd98a
palette = 12=#7fb8ff
palette = 13=#b98cff
palette = 14=#84e4f3
palette = 15=#ffffff
