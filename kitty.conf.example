# Star Wars — kitty. Hand-written so the background can carry alpha; see
# foot.ini. Hyprland does the blurring.
background_opacity 0.72
# Ask the compositor for blur explicitly; see the note in foot.ini.
background_blur 1

foreground #dcd6e6
background #0d0e15
selection_foreground #ffffff
selection_background #26354f

cursor #ffffff
cursor_text_color #0d0e15

active_border_color #7fa6d8
active_tab_background #7fa6d8

color0 #0d0e15
color1 #e5484d
color2 #3ddc97
color3 #f0c05a
color4 #4d9bff
color5 #9b5cff
color6 #4fd1e8
color7 #dcd6e6
color8 #5e5a74
color9 #ff6b72
color10 #74efb8
color11 #ffd98a
color12 #7fb8ff
color13 #b98cff
color14 #84e4f3
color15 #ffffff
